---
import { withBase } from '../utils/paths';
---
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Inicio - Afume</title>
    <link rel="stylesheet" href={withBase("stylesheet.css")} type="text/css">
    <link rel="icon" type="image/svg+xml" href={withBase("imagenes/icono.svg")}>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body id="index-body">
    <div class="fondo">
        <!--NAV-->
        <nav>
            <ul>
                <li><a href={withBase("")}><img src={withBase("imagenes/afume logo.svg")} alt="logo de afume" width="200px"></a></li>
                <li><a class="links" href={withBase("news/")}>NOTICIAS</a></li>
                <li><a class="links" href={withBase("next_matches/")}>PRÓXIMOS PARTIDOS</a></li>
                <li><a class="links" href={withBase("equipos/")}>EQUIPOS</a></li>
                <li><a class="links" href={withBase("competencies/")}>COMPETENCIAS</a></li>
                <li><a class="links" href={withBase("about_us/")}>SOBRE NOSOTROS</a></li>
            </ul>
        </nav>
        
        <!--CUERPO DE PÁGINA-->
        <main class="homecss">
            <section class="fixture" aria-labelledby="fixture-title">
                <h2 id="fixture-title" class="fixture-datos">Fixture resumido</h2>
                <p>Consultá los próximos encuentros del fútbol mendocino.</p>
                <table class="next_matches">
                    <tr>
                        <th colspan="4"><img src={withBase("imagenes/lpf.svg")} alt="liga profesional argentina">LIGA PROFESIONAL ARGENTINA</th>
                    </tr>
                    <tr>
                        <td class="td_hour">Dom 22/11</td>
                        <td class="td_left"><img src={withBase("imagenes/escudos/rosario central.png")} alt="Rosario central">Rosario Central</td>
                        <td class="td_result">vs</td>
                        <td class="td_right"><img src={withBase("imagenes/escudos/gimnasia.png")} alt="gimnasia y esgrima">Gimnasia y Esgrima</td>
                    </tr>
                    <tr>
                        <td class="td_hour">Mié 25/11</td>
                        <td class="td_left"><img src={withBase("imagenes/escudos/boca juniors.svg")} alt="boca juniors">Boca Juniors</td>
                        <td class="td_result">vs</td>
                        <td class="td_right"><img src={withBase("imagenes/escudos/csir.webp")} alt="independiente rivadavia">Independiente Rivadavia</td>
                    </tr>
                </table>
                <table class="next_matches">
                    <tr>
                        <th colspan="4"><img src={withBase("imagenes/b nacional.svg")} alt="b nacional">PRIMERA NACIONAL</th>
                    </tr>
                    <tr>
                        <td class="td_hour">Suspendido</td>
                        <td class="td_left"><img src={withBase("imagenes/escudos/deportivo madryn.svg")} alt="deportivo madryn">Deportivo Madryn</td>
                        <td class="td_result">3ㅤ-ㅤ1</td>
                        <td class="td_right"><img src={withBase("imagenes/escudos/maipu.svg")} alt="deportivo maipú">Deportivo Maipú</td>
                    </tr>
                </table>
                <a class="home-link" href={withBase("next_matches/")}>Ver próximos partidos →</a>
            </section>
            <section class="home-presentacion" aria-labelledby="home-title">
                <h1 id="home-title" class="titulo">AFUME</h1>
                <p class="desc">La enciclopedia del fútbol mendocino.</p>
                <p class="desc">Noticias, equipos, competencias y próximos partidos para seguir a nuestros clubes.</p>
            </section>
            <section class="news" aria-labelledby="home-news-title">
                <h2 id="home-news-title">Noticias</h2>
                <p>Accede a las novedades del fútbol mendocino.</p>
                <a class="home-link" href={withBase("news/")}>Ver noticias →</a>
            </section>
        </main>
    </div>
    <!--FOOTER-->
    <footer>
        <div id="redes">
            <a href="https://instagram.com/afumendoza" target="_blank"><img src={withBase("imagenes/ig.svg")} alt="instagram afume"></a>
        </div>
        <h1>CONTACTO</h1>
        <h3>Agrupación Fútbol de Mendoza (AFUME)</h3>
        <div id="info_empresa">
            <img src={withBase("imagenes/correo.svg")} alt="correo afume">
            <p>support.afume@gmail.com</p>
            <img src={withBase("imagenes/teléfono.svg")} alt="teléfono afume">
            <p>+54 9 261 623-4614</p>
        </div>
        <div>
            <img src={withBase("imagenes/afume logo.svg")} alt="afume logo" width="400px">
        </div>
        <p>Copyright © 2026 AFUME | Todos los derechos reservados.</p>
    </footer>
</body>
</html>
