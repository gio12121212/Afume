---
// @ts-nocheck
import { withBase } from '../../utils/paths';
import equipos from '../../data/equipos.json';

export function getStaticPaths() {
    return equipos.map((equipo) => ({
    params: { id: equipo.id },
    props: { equipo },
    }));
}

const { equipo } = Astro.props;

const eventos = [1, 2, 3, 4, 5, 6, 7, 8, 9]
    .map((n) => ({
        img: equipo[`card${n}Img`],
        texto: equipo[`card${n}`],
        fecha: equipo[`card${n}fecha`],
    }))
    .filter((e) => e.img && e.texto);

const titulos = [1, 2, 3, 4, 5, 6]
    .map((n) => ({
        n,
        img: equipo[`titulo${n}Img`],
        texto: equipo[`titulo${n}`],
    }))
    .filter((t) => t.img && t.texto);

const jugadores = (prefijo, cantidad) =>
    Array.from({ length: cantidad }, (_, i) => i + 1)
        .map((n) => ({
            img: equipo[`${prefijo}${n}Img`],
            nombre: equipo[`${prefijo}${n}`],
            pais: equipo[`${prefijo}${n}Pais`],
            edad: equipo[`${prefijo}${n}Edad`],
        }))
        .filter((j) => j.nombre);

const arqueros = jugadores("arquero", 3);
const defensores = jugadores("defensa", 10);
const medios = jugadores("medio", 10);
const delanteros = jugadores("delantero", 7);
---
<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{equipo.nombre} - Historia</title>
        <meta name="description" content={`Historia de ${equipo.nombre}`} />
        <link rel="stylesheet" href={withBase("stylesheet.css")} type="text/css">
        <link rel="icon" type="image/svg+xml" href={withBase("imagenes/icono.svg")}>
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    </head>
    <body>
        <!--NAV-->
        <div id="fondo-hinchada" style={`background-image: url('${withBase(equipo.hinchadaFondo)}'); background-size: cover; padding: 1px;`}>
            <nav>
                <ul>
                    <li><a href={withBase("")}><img src={withBase("imagenes/afume logo.svg")} alt="logo de afume" width="200px"></a></li>
                    <li><a class="links" href={withBase("news/")}>NOTICIAS</a></li>
                    <li><a class="links" href={withBase("next_matches/")}>PRÓXIMOS PARTIDOS</a></li>
                    <li><a class="links" href={withBase("equipos/")}>EQUIPOS</a></li>
                    <li><a class="links" href={withBase("competencies/")}>COMPETENCIAS</a></li>
                    <li><a class="links" href={withBase("about_us/")}>SOBRE NOSOTROS</a></li>
                </ul>
            </nav>

            <!--CUERPO DE PÁGINA-->
            <div id="datos-equipo">
                <img id="escudo" src={withBase(equipo.escudo)} alt={`Escudo de ${equipo.nombre}`} width="200px">
                <h1>{equipo.nombre}</h1>
                <h3>Fundado el {equipo.fundacion}</h3>
                <h3>Actualmente disputa la {equipo.division}</h3>
                <div id="clasico">
                    <p>Es clásico de {equipo.clasico}</p>
                    <img src={withBase(equipo.escudoClasico)} alt={`Escudo de ${equipo.nombre}`} width="30px">
                </div>
            </div>
        </div>
        {eventos.length > 0 && (
            <h1 class="equipoSeccion">Historia del club</h1>
            <section id="historia">
                {eventos.map((e) => (
                    <div class="evento">
                        <div class="contenido">
                            <img src={withBase(e.img)} alt={`Imagen de ${equipo.nombre}`} width="550px">
                            <div class="texto" set:html={e.texto}></div>
                        </div>
                        <div class="punto"><img src={withBase("imagenes/punto.svg")} alt="punto"></div>
                        <div class="fecha">{e.fecha}</div>
                    </div>
                ))}
            </section>
        )}
        {titulos.length > 0 && (
            <h1 class="equipoSeccion">Títulos</h1>
            <section id="scroll-titulos">
                {titulos.map((t) => (
                    <div class="titulo">
                        <img src={withBase(t.img)} alt={`${t.n}° hito de ${equipo.nombre}`}>
                        <div class="texto" set:html={t.texto}></div>
                    </div>
                ))}
            </section>
        )}
        <h1 class="equipoSeccion">Plantel profesional actual</h1>
        <section id="plantel">
            <h2>Arqueros</h2>
            <div class="posicion">
                {arqueros.map((j) => (
                    <div class="jugador">
                        <img class="rostro" src={withBase(j.img)} alt={`Jugador de ${equipo.nombre}`}>
                        <h3>{j.nombre}</h3>
                        <div>
                            <img src={withBase(j.pais)} alt={`País de ${j.nombre}`} width="50px">
                            <p>{j.edad}</p>
                        </div>
                    </div>
                ))}
            </div>
            <h2>Defensores</h2>
            <div class="posicion scroll-jugadores">
                {defensores.map((j) => (
                    <div class="jugador">
                        <img class="rostro" src={withBase(j.img)} alt={`Jugador de ${equipo.nombre}`}>
                        <h3>{j.nombre}</h3>
                        <div>
                            <img src={withBase(j.pais)} alt={`País de ${j.nombre}`} width="50px">
                            <p>{j.edad}</p>
                        </div>
                    </div>
                ))}
            </div>
            <h2>Mediocampistas</h2>
            <div class="posicion scroll-jugadores">
                {medios.map((j) => (
                    <div class="jugador">
                        <img class="rostro" src={withBase(j.img)} alt={`Jugador de ${equipo.nombre}`}>
                        <h3>{j.nombre}</h3>
                        <div>
                            <img src={withBase(j.pais)} alt={`País de ${j.nombre}`} width="50px">
                            <p>{j.edad}</p>
                        </div>
                    </div>
                ))}
            </div>
            <h2>Delanteros</h2>
            <div class="posicion scroll-jugadores">
                {delanteros.map((j) => (
                    <div class="jugador">
                        <img class="rostro" src={withBase(j.img)} alt={`Jugador de ${equipo.nombre}`}>
                        <h3>{j.nombre}</h3>
                        <div>
                            <img src={withBase(j.pais)} alt={`País de ${j.nombre}`} width="50px">
                            <p>{j.edad}</p>
                        </div>
                    </div>
                ))}
            </div>
            <h2>Director Técnico</h2>
            <div class="posicion">
                <div class="jugador">
                    <img class="rostro" src={withBase(equipo.dtImg)} alt={`Jugador de ${equipo.nombre}`}>
                    <h3>{equipo.dt}</h3>
                    <div>
                        <img src={withBase(equipo.dtPais)} alt={`País de ${equipo.dt}`} width="50px">
                        <p>{equipo.dtEdad}</p>
                    </div>
                </div>
            </div>
        </section>
        <!--FOOTER-->
        <footer>
        <div id="redes">
            <a href="https://instagram.com/afumendoza" target="_blank"><img src={withBase("imagenes/ig.svg")} alt="instagram afume"></a>
        </div>
        <h1>CONTACTO</h1>
        <h3>Agrupación Fútbol de Mendoza (AFUME)</h3>
        <div id="info_empresa">
            <img src={withBase("imagenes/correo.svg")} alt="correo afume">
            <p>support.afume@gmail.com</p>
            <img src={withBase("imagenes/teléfono.svg")} alt="teléfono afume">
            <p>+54 9 261 623-4614</p>
        </div>
        <div>
            <img src={withBase("imagenes/afume logo.svg")} alt="afume logo" width="400px">
        </div>
        <p>Copyright © 2026 AFUME | Todos los derechos reservados.</p>
        </footer>
    </body>
</html>