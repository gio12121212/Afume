---
import { withBase } from '../utils/paths';
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Próximos partidos - Afume</title>
    <link rel="stylesheet" href={withBase("stylesheet.css")} type="text/css">
    <link rel="icon" type="image/svg+xml" href={withBase("imagenes/icono.svg")}>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <!--NAV-->
    <nav>
        <ul>
            <li><a href={withBase("")}><img src={withBase("imagenes/afume logo.svg")} alt="logo de afume" width="200px"></a></li>
            <li><a class="links" href={withBase("news/")}>NOTICIAS</a></li>
            <li><a class="links" href={withBase("next_matches/")}>PRÓXIMOS PARTIDOS</a></li>
            <li><a class="links" href={withBase("equipos/")}>EQUIPOS</a></li>
            <li><a class="links" href={withBase("competencies/")}>COMPETENCIAS</a></li>
            <li><a class="links" href={withBase("about_us/")}>SOBRE NOSOTROS</a></li>
        </ul>
    </nav>
    
    <!--CUERPO DE PÁGINA-->
    <h1>PARTIDOS DENTRO DE LOS PRÓXIMOS 7 DÍAS</h1>
    <table class="next_matches">
        <tr>
            <th colspan="4"><img src={withBase("imagenes/lpf.svg")} alt="liga profesional argentina">LIGA PROFESIONAL ARGENTINA</th>
        </tr>
        <tr>
            <td class="td_hour">Dom 22/11</td>
            <td class="td_left">Rosario Central<img src={withBase("imagenes/Rosario_Central.png")} alt="Rosario central"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/escudos/gimnasia.png")} alt="gimnasia y esgrima">Gimnasia y Esgrima</td>
        </tr>
        <tr>
            <td class="td_hour">Mié 25/11</td>
            <td class="td_left">Boca Juniors<img src={withBase("imagenes/Boca_Juniors.svg")} alt="boca juniors"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/escudos/csir.webp")} alt="independiente rivadavia">Independiente Rivadavia</td>
        </tr>
    </table>
    <table class="next_matches">
        <tr>
            <th colspan="4"><img src={withBase("imagenes/b nacional.svg")} alt="b nacional">PRIMERA NACIONAL</th>
        </tr>
        <tr>
            <td class="td_hour">Suspendido</td>
            <td class="td_left">Deportivo Madryn<img src={withBase("imagenes/Deportivo_Madryn.svg")} alt="deportivo madryn"></td>
            <td class="td_result">3ㅤ-ㅤ1</td>
            <td class="td_right"><img src={withBase("imagenes/escudos/maipu.svg")} alt="deportivo maipú">Deportivo Maipú</td>
        </tr>
    </table>
    <table class="next_matches">
        <tr>
            <th colspan="4"><img src={withBase("imagenes/lgm.WebP")} alt="liga mendocina">LIGA MENDOCINA</th>
        </tr>
        <tr>
            <td class="td_hour">Dom 22/11</td>
            <td class="td_left">San Martín<img src={withBase("imagenes/san martin.png")} alt="san martin"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/gutierrez.svg")} alt="gutierrez sc">Gutierrez SC</td>
        </tr>
        <tr>
            <td class="td_hour">Dom 22/11</td>
            <td class="td_left">Murialdo<img src={withBase("imagenes/murialdo.svg")} alt="murialdo"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/hlh.png")} alt="huracan las heras">Huracán Las Heras</td>
        </tr>
        <tr>
            <td class="td_hour">Dom 2/11</td>
            <td class="td_left">Academia Chacras de Coria<img src={withBase("imagenes/chacras.svg")} alt="academia chacras de coria"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/godoy cruz.png")} alt="godoy cruz">Godoy Cruz</td>
        </tr>
        <tr>
            <td class="td_hour">Dom 22/11</td>
            <td class="td_left">Argentino<img src={withBase("imagenes/argentino.png")} alt="argentino"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/andes talleres.svg")} alt="andes talleres">Andes Talleres</td>
        </tr>
        <tr>
            <td class="td_hour">Dom 22/11</td>
            <td class="td_left">CD Rivadavia<img src={withBase("imagenes/escudos/cd rivadavia.png")} alt="cd rivadavia"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/guaymallen.png")} alt="deportivo guaymallen">Deportivo Guaymallén</td>
        </tr>
        <tr>
            <td class="td_hour">Dom 22/11</td>
            <td class="td_left">FADEP<img src={withBase("imagenes/escudos/fadep.svg")} alt="fadep"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/escudos/cec.png")} alt="cec">CEC</td>
        </tr>
        <tr>
            <td class="td_hour">Dom 22/11</td>
            <td class="td_left">Palmira<img src={withBase("imagenes/escudos/palmira.png")} alt="palmira"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/escudos/uncuyo.webp")} alt="uncuyo">UNCUYO</td>
        </tr>
        <tr>
            <td class="td_hour">Dom 22/11</td>
            <td class="td_left">Luján SC<img src={withBase("imagenes/escudos/lujan.png")} alt="lujan sc"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/escudos/csir.webp")} alt="independiente rivadavia">Independiente Rivadavia</td>
        </tr>
        <tr>
            <td class="td_hour">Dom 22/11</td>
            <td class="td_left">Gimnasia y Esgrima<img src={withBase("imagenes/escudos/gimnasia.png")} alt="gimnasia y esgrima"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/escudos/maipu.svg")} alt="deportivo maipú">Deportivo Maipú</td>
        </tr>
    </table>
    
    <!--FOOTER-->
    <footer>
        <div id="redes">
            <a href="https://instagram.com/afumendoza" target="_blank"><img src={withBase("imagenes/ig.svg")} alt="instagram afume"></a>
        </div>
        <h1>CONTACTO</h1>
        <h3>Agrupación Fútbol de Mendoza (AFUME)</h3>
        <div id="info_empresa">
            <img src={withBase("imagenes/correo.svg")} alt="correo afume">
            <p>support.afume@gmail.com</p>
            <img src={withBase("imagenes/teléfono.svg")} alt="teléfono afume">
            <p>+54 9 261 623-4614</p>
        </div>
        <div>
            <img src={withBase("imagenes/afume logo.svg")} alt="afume logo" width="400px">
        </div>
        <p>Copyright © 2026 AFUME | Todos los derechos reservados.</p>
    </footer>
</body>
</html>