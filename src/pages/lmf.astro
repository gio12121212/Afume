---
import { withBase } from '../utils/paths';

const campeones = [
    { anio: 2025, nombre: 'Atlético Argentino', foto: 'imagenes/campeon2025.png' },
    { anio: 2024, nombre: 'FADEP', foto: 'imagenes/campeon2024.png' },
    { anio: 2023, nombre: 'FADEP', foto: 'imagenes/campeon2023.png' },
    { anio: 2022, nombre: 'Atlético San Martín', foto: 'imagenes/campeon2022.png' },
    { anio: 2021, nombre: 'Andes Talleres', foto: 'imagenes/campeon2021.png' },
];
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href={withBase("stylesheet.css")} type="text/css">
    <link rel="icon" type="image/svg+xml" href={withBase("imagenes/icono.svg")}>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <title>Liga Mendocina - AFUME</title>
</head>
<body>
    <nav>
        <ul>
            <li><a href={withBase("")}><img src={withBase("imagenes/afume logo.svg")} alt="logo de afume" width="200px"></a></li>
            <li><a class="links" href={withBase("news/")}>NOTICIAS</a></li>
            <li><a class="links" href={withBase("next_matches/")}>PRÓXIMOS PARTIDOS</a></li>
            <li><a class="links" href={withBase("equipos/")}>EQUIPOS</a></li>
            <li><a class="links" href={withBase("competencies/")}>COMPETENCIAS</a></li>
            <li><a class="links" href={withBase("about_us/")}>SOBRE NOSOTROS</a></li>
        </ul>
    </nav>
    <a href={withBase("competencies/")} class='volver' aria-label='volver a competencias'>
        &#10094;
    </a>
    <h1>Liga Mendocina de Fútbol</h1>
    <img class="copa" src={withBase("imagenes/lgm.WebP")} alt="foto de la competencia">
    <h3>Liga regional de la provincia de Mendoza.</h3>
    <hr>
    <h1 class='txtcopas'>Campañas destacadas</h1>
    <img class='fotologro' src={withBase('imagenes/depguayma2025.png')} alt='mejor equipo'>
    <h3 class='txtcopas'>Deportivo Guaymallén - 2025</h3>
    <h4 class='txtcopas'>Consiguió sacar 105 puntos en la tabla anual ganando 32 y empatando 9 partidos; solo perdió 2 en todo el año, logrando así la mejor campaña en la actualidad.
    </h4>
    <h3>Bonus</h3>
    <h4 class="txtcopas">Atlético Argentino logró 103 puntos, Luján logró 99 puntos y FADEP 98 en la <b>¡misma temporada!</b></h4>
    <hr>
    <h1 class='txtcopas'>Los mejores del 2026</h1>
    <h3 class='txtcopas'>Gimnasia y Esgrima - <b>zona 1</b></h3>
    <h4 class='txtcopas'>Tiene 41 puntos con 13 ganados, 2 empates y uno perdido; lo sigue Huracán Las Heras con 36 puntos y Godoy Cruz con 34 puntos.</h4>
    <h3 class='txtcopas'>Atlético Argentino - <b>zona 2</b></h3>
    <h4 class='txtcopas'>Tiene 41 puntos con 13 ganados, 2 empates y uno perdido; lo sigue Murialdo con 33 puntos y Luján Sport Club con 31 puntos.</h4>

    <hr>
    <h1 class='txtcopas'>Últimos campeones</h1>
    <div class="campeones">
        {campeones.map((c) => (
            <div class="campeon">
                <img src={withBase(c.foto)} alt={`${c.nombre} campeón ${c.anio}`}>
                <h2>{c.anio}</h2>
                <h3>{c.nombre}</h3>
            </div>
        ))}
    </div>

    <!--FOOTER-->
    <footer>
        <div id="redes">
            <a href="https://instagram.com/afumendoza" target="_blank"><img src={withBase("imagenes/ig.svg")} alt="instagram afume"></a>
        </div>
        <h1>CONTACTO</h1>
        <h3>Agrupación Fútbol de Mendoza (AFUME)</h3>
        <div id="info_empresa">
            <img src={withBase("imagenes/correo.svg")} alt="correo afume">
            <p>support.afume@gmail.com</p>
            <img src={withBase("imagenes/teléfono.svg")} alt="teléfono afume">
            <p>+54 9 261 623-4614</p>
        </div>
        <div>
            <img src={withBase("imagenes/afume logo.svg")} alt="afume logo" width="400px">
        </div>
        <p>Copyright © 2026 AFUME | Todos los derechos reservados.</p>
    </footer>
</body>
</html>